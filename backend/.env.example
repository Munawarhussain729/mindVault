# Copy to .env and adjust. Never commit the real .env file.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# true for local development only
DJANGO_DEBUG=true

# Comma-separated. Required when DJANGO_DEBUG is false.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call the API (your frontend URL).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
